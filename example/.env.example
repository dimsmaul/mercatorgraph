# --- images -------------------------------------------------------------
# GHCR (default): path-style, one repo per service
IMAGE_PREFIX=ghcr.io/dimsmaul/mercatorgraph
TAG=latest
# Docker Hub alternative (single repo, service-in-tag): set images explicitly in
# docker-compose.yml instead, e.g. dimsmaul/mercatorgraph:worker-${TAG}

# --- postgres -----------------------------------------------------------
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me          # <-- set a real password
POSTGRES_DB=knowledge

# --- worker -------------------------------------------------------------
WORKER_CORS_ORIGINS=*                # tighten to your docs origin in production
DEBOUNCE_SECONDS=0                   # >0 to coalesce webhook push bursts (seconds)
NOTIFY_URL=                          # POST build.succeeded events here (Slack-compatible)
ENCRYPTION_KEY=                      # Fernet key to decrypt repo deploy keys (private repos)

# per-project webhook HMAC secrets (names referenced from projects.yaml)
# WEBHOOK_SECRET_DEMO=change-me

# --- docs ---------------------------------------------------------------
PUBLIC_WORKER_URL=http://localhost:8000   # browser-reachable worker URL

# Fumadocs docs app: bun build -> Next standalone -> node runtime.
FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY . .
# content/docs ships the committed landing page; per-project pages are generated by ckdocs.
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM node:22-slim AS run
WORKDIR /app
# WORKER_URL is read at runtime (via /api/config), not baked at build.
ENV NODE_ENV=production PORT=3000 WORKER_URL=http://localhost:8000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]

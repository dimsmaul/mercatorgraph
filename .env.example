# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://knowledge:change-me@postgres:5432/knowledge

# Shared data volume (versioned graph output lives here)
DATA_DIR=/data

# Worker
PROJECTS_CONFIG=/app/projects.yaml
# Coalesce bursts of webhook pushes per project into one build (seconds). 0 = off.
DEBOUNCE_SECONDS=0
# Notify this webhook URL on successful build/promote (Slack-compatible). Empty = off.
NOTIFY_URL=
# Regenerate docs MDX into this dir after each promote (pipeline A still needs a docs
# rebuild to serve). Empty = off. e.g. /docs-content/docs on a shared volume.
DOCS_CONTENT_DIR=
# per-project webhook secrets referenced from projects.yaml as ${VAR}
# e.g. WEBHOOK_SECRET_DEMO=...

# MCP
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Docs app — browser-reachable worker URL (served via /api/config)
PUBLIC_WORKER_URL=http://localhost:8000
# Worker CORS allow-list for the docs origin (comma-separated, or *)
WORKER_CORS_ORIGINS=*

# Image publishing (docker compose build/push, Makefile)
# IMAGE_PREFIX=ghcr.io/<you>
# TAG=0.1.0
